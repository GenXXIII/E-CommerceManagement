{
  "realm": "nexrig",
  "enabled": true,
  "displayName": "NEXRIG",
  "loginTheme": "nexrig",
  "registrationAllowed": true,
  "defaultRoles": ["customer"],
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@nexrig.local",
    "fromDisplayName": "NEXRIG"
  },
  "roles": {
    "realm": [
      { "name": "customer", "description": "NEXRIG storefront customer" },
      { "name": "admin", "description": "NEXRIG operations administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "nexrig-web",
      "name": "NEXRIG web application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "baseUrl": "http://localhost:5173/",
      "rootUrl": "http://localhost:5173",
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "nexrig-web audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nexrig-web",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "email": "user@demo.local",
      "firstName": "Demo",
      "lastName": "Customer",
      "realmRoles": ["customer"],
      "credentials": [
        { "type": "password", "value": "1234", "temporary": false }
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@nexrig.local",
      "firstName": "Demo",
      "lastName": "Administrator",
      "realmRoles": ["admin"],
      "credentials": [
        { "type": "password", "value": "1234", "temporary": false }
      ]
    }
  ]
}
